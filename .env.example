APP_PORT=3000
NODE_ENV=development
AUTH_USER=admin
AUTH_PASSWORD=change-me
AUTH_SESSION_SECRET=replace-with-long-random-string
# Set true only when service is opened via HTTPS.
AUTH_COOKIE_SECURE=false
# Dedicated bearer token for the local MCP adapter. Use a long random value.
MCP_API_TOKEN=replace-with-a-long-random-token
OUTREACH_BASE_URL=http://127.0.0.1:3000
MCP_CONFIRMATION_TTL_SECONDS=600
MCP_REQUEST_TIMEOUT_MS=15000
DATABASE_URL=postgres://outreach:outreach@localhost:5432/outreach
POSTGRES_DB=outreach
POSTGRES_USER=outreach
POSTGRES_PASSWORD=outreach
POSTGRES_PORT=55432

PUBLIC_TRACKING_URL=
MAIL_DRY_RUN=true
ATTACHMENT_DIR=storage/attachments
MAX_ATTACHMENT_MB=50
DKIM_SELECTORS=mail,default,selector1,yandex

WORKER_POLL_MS=5000
INBOX_SYNC_INTERVAL_MINUTES=1
VALIDATION_BATCH_SIZE=100
